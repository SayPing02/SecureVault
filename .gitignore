# --- Rust ---
# Build output. Per Tauri's advice, the target folder is never committed.
/src-tauri/target/
/dist/

# --- Node / frontend ---
node_modules/
.vite/

# --- Tauri generated files ---
# `gen/` holds schemas regenerated on every build.
/src-tauri/gen/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.vs/

# --- Claude Code local session files (not shared project config) ---
.claude/

# NOTE: Cargo.lock IS committed (see README) so builds are reproducible.
.github/workflows/ci.yml
